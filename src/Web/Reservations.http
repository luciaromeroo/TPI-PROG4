# ------------------------------------------------------------------
# Pruebas de Reservas + reglas de negocio del TPI
# Levantar la API primero: cd src/Web y dotnet run (queda en http://localhost:5231)
#
# ALGUNOS CASOS NECESITAN DATOS PREVIOS en src/Web/hotelDataBase.db (no hay
# endpooints de rooms ni de clientes por usuario todavía):
#   - Un cliente (rol 1 = Client/logueado o via POST api/users).
#   - Tres habitaciones HABILITADAS (State = 1) con capacidades distintas, por
#     ejemplo: id 1 (cap 2), id 2 (cap 1), id 3 (cap 4) y una DESHABILITADA id 4 (State = 0).
#   INSERT INTO Room (Number, Type, PricePerNight, State, Capacity)
#   VALUES (101, 1, 15000, 1, 2), (102, 2, 25000, 1, 1), (103, 4, 40000, 1, 4), (104, 1, 15000, 0, 2);
# ------------------------------------------------------------------

###
# 1) Crear reserva VÁLIDA con 2 habitaciones (total = 4 noches x (15000 + 25000) = 160000)
POST http://localhost:5231/api/reservations
Content-Type: application/json

{
  "startDate": "2026-11-01",
  "endDate": "2026-11-05",
  "userId": 1,
  "rooms": [
    { "roomId": 1, "guestsNumber": 2 },
    { "roomId": 2, "guestsNumber": 1 }
  ]
}

###
# 2) Reserva sin habitaciones -> 400 RESERVATION_MUST_HAVE_ROOMS
POST http://localhost:5231/api/reservations
Content-Type: application/json

{
  "startDate": "2026-11-01",
  "endDate": "2026-11-05",
  "userId": 1,
  "rooms": []
}

###
# 3) Misma habitación repetida -> 400 DUPLICATED_ROOM_IN_RESERVATION
POST http://localhost:5231/api/reservations
Content-Type: application/json

{
  "startDate": "2026-11-01",
  "endDate": "2026-11-05",
  "userId": 1,
  "rooms": [
    { "roomId": 1, "guestsNumber": 2 },
    { "roomId": 1, "guestsNumber": 1 }
  ]
}

###
# 4) Habitación que no existe -> 404 ROOM_NOT_FOUND
POST http://localhost:5231/api/reservations
Content-Type: application/json

{
  "startDate": "2026-11-01",
  "endDate": "2026-11-05",
  "userId": 1,
  "rooms": [ { "roomId": 999, "guestsNumber": 2 } ]
}

###
# 5) Habitación fuera de servicio (la 104 está State = 0) -> 400 ROOM_OUT_OF_SERVICE
POST http://localhost:5231/api/reservations
Content-Type: application/json

{
  "startDate": "2026-11-10",
  "endDate": "2026-11-12",
  "userId": 1,
  "rooms": [ { "roomId": 4, "guestsNumber": 2 } ]
}

###
# 6) Más huéspedes que la capacidad (la 2 tiene cap 1) -> 400 GUESTS_EXCEED_ROOM_CAPACITY
POST http://localhost:5231/api/reservations
Content-Type: application/json

{
  "startDate": "2026-11-10",
  "endDate": "2026-11-12",
  "userId": 1,
  "rooms": [ { "roomId": 2, "guestsNumber": 3 } ]
}

###
# 7) Fecha pasada -> 400 START_DATE_IN_THE_PAST
POST http://localhost:5231/api/reservations
Content-Type: application/json

{
  "startDate": "2026-01-01",
  "endDate": "2026-01-05",
  "userId": 1,
  "rooms": [ { "roomId": 1, "guestsNumber": 2 } ]
}

###
# 8) Fechas invertidas -> 400 INVALID_RESERVATION_DATES
POST http://localhost:5231/api/reservations
Content-Type: application/json

{
  "startDate": "2026-11-05",
  "endDate": "2026-11-01",
  "userId": 1,
  "rooms": [ { "roomId": 1, "guestsNumber": 2 } ]
}

###
# 9) Cliente inexistente -> 404 USER_NOT_FOUND
POST http://localhost:5231/api/reservations
Content-Type: application/json

{
  "startDate": "2026-11-01",
  "endDate": "2026-11-05",
  "userId": 999,
  "rooms": [ { "roomId": 1, "guestsNumber": 2 } ]
}

###
# 10) OVERBOOKING: la 101 ya está asignada a la reserva del caso 1 en nov 1-5.
#      Estas fechas se pisan -> 400 ROOM_NOT_AVAILABLE_FOR_DATES
POST http://localhost:5231/api/reservations
Content-Type: application/json

{
  "startDate": "2026-11-04",
  "endDate": "2026-11-08",
  "userId": 1,
  "rooms": [ { "roomId": 1, "guestsNumber": 2 } ]
}

###
# 11) CHECK-OUT de una = CHECK-IN de otra (nov 1-5 y nov 5-8): el doc lo permite -> 201
POST http://localhost:5231/api/reservations
Content-Type: application/json

{
  "startDate": "2026-11-05",
  "endDate": "2026-11-08",
  "userId": 1,
  "rooms": [ { "roomId": 1, "guestsNumber": 2 } ]
}

###
# 12) Cambiar las fechas de una reserva PENDIENTE -> 200 con total recalculado
PUT http://localhost:5231/api/reservations/1
Content-Type: application/json

{
  "endDate": "2026-11-06"
}

###
# 13) Fechas válidas pero la habitación está ocupada en el rango nuevo -> 400 ROOM_NOT_AVAILABLE_FOR_DATES
PUT http://localhost:5231/api/reservations/1
Content-Type: application/json

{
  "startDate": "2026-11-02",
  "endDate": "2026-11-04"
}

###
# 14) Editar una reserva CONFIRMADA o CANCELADA -> 400 RESERVATION_NOT_EDITABLE
# (antes: PATCH /api/reservations/1/confirm para confirmarla)

###
# 15) Registrá una seña y probá lo del tope por pagos:
POST http://localhost:5231/api/payments
Content-Type: application/json

{
  "reservationId": 1,
  "amount": 50000,
  "paymentMethod": "Tarjeta"
}

###
# 15b) Bajar fechas a 2 noches da total 80000: sigue por encima de 50000 pagados -> 200
PUT http://localhost:5231/api/reservations/1
Content-Type: application/json

{
  "endDate": "2026-11-03"
}

###
# 15c) Bajar fechas todavía más da 40000: queda por debajo de lo pagado
#      -> 400 RESERVATION_TOTAL_BELOW_REGISTERED_PAYMENTS
PUT http://localhost:5231/api/reservations/1
Content-Type: application/json

{
  "endDate": "2026-11-02"
}

###
# 16) Borrar una reserva CON pagos -> 400 RESERVATION_HAS_PAYMENTS
DELETE http://localhost:5231/api/reservations/1

###
# 16b) Borrar una reserva SIN pagos -> 204 y después GET de ese id -> 404
DELETE http://localhost:5231/api/reservations/2

###
# 17) Consultas: todas, por id y por cliente (la lista muestra las habitaciones)
GET http://localhost:5231/api/reservations

###
GET http://localhost:5231/api/reservations/1

###
GET http://localhost:5231/api/reservations/user/1
