# Copiá este archivo como ".env" (en la misma carpeta) y completá los valores.
# El .env NO se sube a git (está en .gitignore); este .env.example sí, como guía.
# El doble guion bajo (__) equivale a ":" de appsettings.json: Jwt__SecretKey = Jwt:SecretKey

# Clave para firmar los tokens JWT. Mínimo 32 caracteres, cada integrante puede tener la suya.
Jwt__SecretKey=reemplazar-por-una-clave-larga-de-al-menos-32-caracteres

# Primer SuperAdmin, se crea al arrancar la API si no existe ninguno.
SuperAdminSeed__Mail=superadmin@hotel.com
SuperAdminSeed__Password=reemplazar-por-una-contraseña
